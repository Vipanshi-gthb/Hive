# ==============================================================================
# Hive-Cortex Frontend — Environment Variables Reference
# Copy this file to .env (gitignored) and fill in real values.
# All variables MUST be prefixed with VITE_ to be exposed to the browser bundle.
# ==============================================================================

# Base URL of the Spring Boot backend API.
# Development:  http://localhost:8080
# Production:   https://your-backend.render.com  (or Railway/Fly.io URL)
VITE_API_BASE_URL=http://localhost:8080
