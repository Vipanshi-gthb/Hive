# ==============================================================================
# Hive-Cortex — Environment Variables Reference
# Copy this file to .env (which is gitignored) and fill in real values.
# NEVER commit .env or any file containing real credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------

# Full JDBC URL for PostgreSQL.
# Local example:  jdbc:postgresql://localhost:5432/hivecortex
# Supabase:       jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
# Neon:           jdbc:postgresql://<host>.neon.tech/neondb?sslmode=require
# Render:         jdbc:postgresql://<host>.render.com:5432/<db-name>
DATABASE_URL=jdbc:postgresql://localhost:5432/hivecortex

DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_db_password

# ------------------------------------------------------------------------------
# JWT (added in Prompt 008)
# ------------------------------------------------------------------------------

# Minimum 256-bit (32-char) random string. Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# CORS (added in Prompt 005)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# AI / Gemini (added in AI pipeline prompts)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# pgvector — Manual Setup Step (one-time, per database)
# ------------------------------------------------------------------------------
# Before starting the backend, connect to your PostgreSQL database and run:
#
#   CREATE EXTENSION IF NOT EXISTS vector;
#
# Verify with:  \dx
#
# For hosted providers:
#   Supabase:  Pre-enabled — no action needed.
#   Neon:      Run in the Neon SQL editor.
#   Render:    Run via psql or Render's query console.
#   Local:     Requires pgvector compiled and installed. See:
#              https://github.com/pgvector/pgvector#installation
# ==============================================================================
